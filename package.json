{
  "name": "abyss-watcher",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bunx --bun react-router build",
    "dev": "bunx --bun react-router dev",
    "start": "bunx --bun react-router-serve ./build/server/index.js",
    "preview": "bun --bun run build && bun --bun run vite preview",
    "typecheck": "bunx --bun react-router typegen && tsc",
    "db:push": "bunx --bun rizzle-kit push",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate": "bunx --bun drizzle-kit migrate",
    "db:studio": "bunx --bun drizzle-kit studio"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@libsql/client": "^0.15.15",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@react-router/node": "^7.11.0",
    "@react-router/serve": "^7.11.0",
    "canvas": "^3.2.0",
    "croner": "^9.1.0",
    "drizzle-orm": "^0.45.1",
    "es-toolkit": "^1.43.0",
    "isbot": "^5",
    "lucide-react": "^0.562.0",
    "p-queue": "^9.0.1",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "react": "^19.3.0-canary-65eec428-20251218",
    "react-dom": "^19.3.0-canary-65eec428-20251218",
